# Optional. The official public endpoint is used when this is empty.
# For a deployed demo, use a private Base RPC URL from a node provider.
BASE_RPC_URL=https://mainnet.base.org

# Required for verified source metadata. Etherscan keeps source/ABI endpoints
# free on Base even though general Base API data now requires a paid plan.
# Server-only: never rename this with NEXT_PUBLIC_, commit a value, or share it.
ETHERSCAN_API_KEY=

# Recommended for free Base contract creation and normal-transaction history.
# Shield uses this key for both Blockscout compatibility and modern REST routes.
# Create a free PRO API key at https://dev.blockscout.com/ (no credit card).
# Server-only: never rename this with NEXT_PUBLIC_, commit a value, or share it.
BLOCKSCOUT_API_KEY=

# Reserved for a future evidence-summary layer. It cannot control verdicts.
AI_API_KEY=
AI_MODEL=
